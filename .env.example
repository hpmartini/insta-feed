API_PORT=3001
# relativ zum API-Arbeitsverzeichnis; Elternordner wird angelegt; ":memory:" möglich
DATABASE_PATH=data/insta-feed.db
# KI-Auswahl: AI_PROVIDER=mock erzwingt den Mock (auch mit Key); sonst Gemini bei gesetztem Key; sonst Mock
AI_PROVIDER=mock
# optional; ohne Key läuft der Mock
GEMINI_API_KEY=
# Browser ruft same-origin /api; Next-Route (apps/web/app/api) leitet serverseitig hierhin weiter
API_INTERNAL_URL=http://localhost:3001
