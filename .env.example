API_PORT=3001
# relativ zum API-Arbeitsverzeichnis; Elternordner wird angelegt; ":memory:" möglich
DATABASE_PATH=data/insta-feed.db
# KI-Auswahl: AI_PROVIDER=mock erzwingt den Mock (auch mit Key); sonst Gemini bei gesetztem Key; sonst Mock
AI_PROVIDER=mock
# optional; ohne Key läuft der Mock
GEMINI_API_KEY=
# Browser ruft same-origin /api; next.config.ts-Rewrite leitet hierhin weiter (wird beim `next build` fixiert!)
API_URL=http://localhost:3001
# Öffentlicher Web-Origin für die Origin-Prüfung in apps/web/middleware.ts; leer = aus Host/X-Forwarded-* abgeleitet
PUBLIC_ORIGIN=
# Hinweis: `bun run dev` startet jedes Workspace mit eigenem cwd; Next liest nur apps/web/.env, Bun nur apps/api/.env.
# Root-.env also nach apps/web/.env bzw. apps/api/.env kopieren oder Variablen exportieren. Vorgaben laufen ohne .env.
