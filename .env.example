# Copy to .env.local and fill in. Never commit real keys.

# Optional: enables Gemini for summaries and story clustering. Without it a deterministic mock is used.
GEMINI_API_KEY=
# Optional: Gemini model (default gemini-2.5-flash)
GEMINI_MODEL=
# Optional: alternative Gemini endpoint (gateway or local test double)
GEMINI_BASE_URL=
# Optional: SQLite file (default ./data/instafeed.sqlite)
DB_PATH=
# Optional: Jaccard threshold for the mock clustering, 0..1 (default 0.5)
CLUSTERING_THRESHOLD=
